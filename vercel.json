{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/lifecycle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/cron/reactivation",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/v1/cron/social-posts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/v1/admin/marketing/search/cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/v1/admin/analytics/snapshot",
      "schedule": "0 7 * * *"
    }
  ]
}
